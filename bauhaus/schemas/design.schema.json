{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bauhaus.design/schemas/design.schema.json",
  "title": "Bauhaus Design Document",
  "description": "Versioned scene-graph schema for editable Bauhaus graphic design documents.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "canvas", "elements"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "poster",
        "flyer",
        "social",
        "banner",
        "certificate",
        "invitation",
        "infographic",
        "presentation",
        "thumbnail",
        "branding",
        "other"
      ],
      "default": "other"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "enum": ["px", "mm", "in"], "default": "px" },
        "dpi": { "type": "number", "minimum": 72, "default": 72 },
        "bleed": { "type": "number", "minimum": 0, "default": 0 },
        "background": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["solid", "linear", "radial", "transparent"],
              "default": "solid"
            },
            "color": { "type": "string" },
            "angle": { "type": "number" },
            "stops": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["offset", "color"],
                "properties": {
                  "offset": { "type": "number", "minimum": 0, "maximum": 1 },
                  "color": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family", "source"],
        "properties": {
          "family": { "type": "string" },
          "source": { "type": "string", "enum": ["google", "system", "local"] },
          "url": { "type": "string" },
          "weights": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      },
      "default": []
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourceType", "src"],
        "properties": {
          "id": { "type": "string" },
          "sourceType": { "type": "string", "enum": ["user", "generated", "stock", "local"] },
          "src": { "type": "string" },
          "license": { "type": "string" },
          "attribution": { "type": "string" }
        }
      },
      "default": []
    },
    "elements": {
      "type": "array",
      "items": { "$ref": "element.schema.json" }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "brief": { "type": "string" },
        "creativeDirection": { "type": "string" },
        "targetAudience": { "type": "string" },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "palette": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
